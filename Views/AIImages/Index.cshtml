@model IEnumerable<WDPAssessment3.Models.AIImage>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@{
    if (User.Identity.IsAuthenticated)
    {
        <p>
            <a asp-action="Create">Create New</a>
        </p>            
    }
}

@foreach (var item in Model)
{
    <h2>@Html.DisplayFor(modelItem => item.Prompt)</h2>
    @*<p>@Html.DisplayFor(modelItem => item.Like)</p>*@
    <p>
    @{
            for (int i = 0; i < item.Like; i++)
            {
                <span style="color: #f8bd08; ">&#x2605;</span>
            }
            for (int i = 0; i < 5 - item.Like; i++)
            {
                <span>&#x2606;</span>
            }
        }
    </p>
    <img src="~/images/@item.StorageFile" />
    <p>@Html.DisplayFor(modelItem => item.ImageGenerator)</p>
    <p>Posted by <b>@Html.DisplayFor(modelItem => item.UserName)</b> on @Html.DisplayFor(modelItem => item.UploadDate)</p>
    <p>
        @if (User.IsInRole("admin"))
        {
            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
        }

        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info">Details</a>

        @if (User.IsInRole("admin"))
        {
            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
        }

        <a asp-action="IncreaseLike" asp-route-id="@item.Id" class="btn btn-success">Like (+)</a>
    </p>
    <hr />
}